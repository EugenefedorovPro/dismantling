# Example only: install as a separate Nginx site on the kant VPS.
# The certificate must cover dismantle.rhyme.kyiv.ua (an existing wildcard
# certificate is fine if its SAN includes this hostname).
server {
    listen 80;
    server_name dismantle.rhyme.kyiv.ua;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name dismantle.rhyme.kyiv.ua;

    ssl_certificate /etc/ssl/certs/dismantle.rhyme.kyiv.ua.pem;
    ssl_certificate_key /etc/ssl/private/dismantle.rhyme.kyiv.ua.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }
}
